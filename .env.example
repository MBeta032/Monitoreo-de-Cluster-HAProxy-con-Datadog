# Copia este archivo con el nombre .env (en esta misma carpeta) y llena los valores.
# El .env NUNCA se sube a GitHub: está en .gitignore.

# Clave de API de Datadog (Organization Settings > API Keys). La configura Jhon.
DD_API_KEY=
# Región (sitio) de la cuenta de Datadog, por ejemplo: datadoghq.com o us5.datadoghq.com
DD_SITE=
# Application Key de Datadog (opcional): solo la usa artillery/analizar_datadog.py para consultar métricas.
DD_APP_KEY=

# Workers de Gunicorn por backend (si no se definen, cada uno usa 2). Ver README, sección 6.
BACKEND1_WORKERS=2
BACKEND2_WORKERS=2
BACKEND3_WORKERS=2

# Base de datos PostgreSQL de la boletería. La contraseña es obligatoria (sin ella docker compose no arranca).
# Solo se aplica al crear el volumen pg-data: si la cambias después, ver README, sección 11.
POSTGRES_DB=boleteria
POSTGRES_USER=boleteria
POSTGRES_PASSWORD=
# Contraseña del usuario de solo lectura "datadog" que usa el Agent para vigilar PostgreSQL.
# Obligatoria; solo letras y números. Se aplica al crear pg-data (si se cambia, hay que recrear el volumen).
DD_POSTGRES_PASSWORD=

# Clave que firma la cookie de sesión de los backends. Obligatoria y la misma para los 3.
# Para generarla sin instalar Python (corre dentro de un contenedor; README, sección 4.3):
#   docker run --rm python:3.14-slim python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Artillery: cuenta de PRUEBA de la taquilla con la que inician sesión los usuarios virtuales.
# NECESARIAS para artillery/normal.yml, pico.yml y pico-datadog.yml: si quedan vacías, todos los
# usuarios virtuales fallan con JJ_CREDENCIALES_AUSENTES. Los valores de abajo son la cuenta de
# prueba del seed (db/init/02_seed.sql), ya publicada en el README, sección 6.1: no son secretos.
# Si tu .env es anterior a este cambio, agrégale estas dos líneas.
# JJ_EVENT_ID: ID numérico de un evento existente; 1 corresponde al seed inicial.
JJ_EMAIL=demo@taquilla.test
JJ_PASSWORD=Taquilla2026!
JJ_EVENT_ID=1
