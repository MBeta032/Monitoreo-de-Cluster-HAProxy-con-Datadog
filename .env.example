# Copia este archivo con el nombre .env (en esta misma carpeta) y llena los valores.
# El .env NUNCA se sube a GitHub: está en .gitignore.

# Clave de API de Datadog (Organization Settings > API Keys). La configura Jhon.
DD_API_KEY=
# Región (sitio) de la cuenta de Datadog, por ejemplo: datadoghq.com o us5.datadoghq.com
DD_SITE=

# Workers de Gunicorn por backend (si no se definen, cada uno usa 2). Ver README, sección 6.
BACKEND1_WORKERS=2
BACKEND2_WORKERS=2
BACKEND3_WORKERS=2
